#!/usr/bin/env python3
# Reorders the nodes of the TETRA15 blocks of an Exodus file between the two
# orders in use:
#
#   ioss   IOSS and the Exodus library (Ioss_Tet15.C), written by Carina and
#          Sierra/SM TET15-P1: face nodes 10-13 on faces (0,1,2), (1,2,3),
#          (0,2,3), (0,1,3), centroid 14 (0-based)
#   cubit  Cubit 17.10.5 `tetra15` export, and what the VTK readers of
#          ParaView assume: centroid 10, face nodes 11-14 on faces (0,1,2),
#          (1,2,3), (0,2,3), (0,1,3)
#
# Usage:
#   tetra15-reorder --to cubit|paraview|ioss <input.e> <output.e>
#
# `--to cubit` (or `--to paraview`, the same) makes a Carina or Sierra/SM
# TET15-P1 output display correctly in ParaView; `--to ioss` makes a Cubit
# `tetra15` mesh usable by Carina and Sierra/SM TET15-P1.  Only the
# connectivity of the TETRA15 blocks changes;
# coordinates, variables, side sets (element/side pairs) and node sets are
# copied unchanged.  The present order of each block is found from the
# coordinates: the centroid node is the one of nodes 10 and 14 nearest to the
# mean of the four vertices, and it must be the same node in every element.
# A block already in the requested order is left as it is.  Works on the
# pieces of a decomposed file (out.e.N.n) one at a time.  Needs netCDF4.
import argparse
import shutil
import sys

import numpy as np
from netCDF4 import Dataset

# Columns of the new connectivity, as columns of the old one (0-based).
TO_CUBIT = list(range(10)) + [14, 10, 11, 12, 13]
TO_IOSS = list(range(10)) + [11, 12, 13, 14, 10]


def coordinates(nc):
    if "coordx" in nc.variables:
        return np.stack([nc.variables["coord" + c][:] for c in "xyz"], axis=1)
    return np.asarray(nc.variables["coord"][:]).T


def present_order(conn, X, name):
    """'ioss' or 'cubit', from where the centroid node of each element is."""
    e = conn - 1
    c = X[e[:, :4]].mean(axis=1)
    d10 = np.linalg.norm(X[e[:, 10]] - c, axis=1)
    d14 = np.linalg.norm(X[e[:, 14]] - c, axis=1)
    n_ioss, n_cubit = int(np.sum(d14 < d10)), int(np.sum(d10 < d14))
    if n_ioss == len(e):
        return "ioss"
    if n_cubit == len(e):
        return "cubit"
    sys.exit("tetra15-reorder: %s mixes the two orders (%d elements with the centroid at node 14, "
             "%d at node 10, %d undecided); nothing written" % (name, n_ioss, n_cubit, len(e) - n_ioss - n_cubit))


def main():
    p = argparse.ArgumentParser(description="Reorder TETRA15 connectivity between the IOSS and Cubit orders.")
    p.add_argument("--to", required=True, choices=["cubit", "paraview", "ioss"])
    p.add_argument("input")
    p.add_argument("output")
    a = p.parse_args()
    if a.to == "paraview":
        a.to = "cubit"

    with Dataset(a.input) as nc:
        X = coordinates(nc)
        blocks = [v for v in nc.variables
                  if v.startswith("connect") and str(getattr(nc.variables[v], "elem_type", "")).upper() == "TETRA15"]
        if not blocks:
            sys.exit("tetra15-reorder: %s has no TETRA15 block; nothing written" % a.input)
        orders = {v: present_order(np.asarray(nc.variables[v][:]), X, v) for v in blocks if nc.variables[v].size}

    shutil.copyfile(a.input, a.output)
    perm = TO_CUBIT if a.to == "cubit" else TO_IOSS
    with Dataset(a.output, "r+") as nc:
        for v, order in orders.items():
            if order == a.to:
                print("tetra15-reorder: %s already in the %s order, left as it is" % (v, a.to))
                continue
            var = nc.variables[v]
            var[:] = np.asarray(var[:])[:, perm]
            print("tetra15-reorder: %s, %d elements, %s -> %s" % (v, var.shape[0], order, a.to))
    return 0


if __name__ == "__main__":
    sys.exit(main())
