# julia manifest, do not push this
Manifest.toml

# coverage artifacts from `julia --code-coverage=...`
*.jl.*.cov
*.jl.cov
lcov.info

# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
*.[oa]
/build*/
/build*
docs/build/
/sandbox/
.DS_Store
.vscode
*.e
*.exo
*.log
.JuliaFormatter.toml
Carina.jl.code-workspace
examples/mechanics/explicit-dynamic/clamped/.clamped.yaml.swp
# large generated meshes: rebuild with benchmark/meshgen.jl (see benchmark/README.md)
benchmark/meshes/

# LaTeX build artifacts from the theory manual (theory/Makefile).  The PDF is
# a build product too: it is regenerated by `make` and would otherwise churn a
# half-megabyte binary on every prose edit.
theory/*.aux
theory/*.bbl
theory/*.blg
theory/*.out
theory/*.toc
theory/*.lof
theory/*.lot
theory/*.loa
theory/*.fls
theory/*.fdb_latexmk
theory/*.synctex.gz
theory/*.pdf
theory/chapters/*.aux
